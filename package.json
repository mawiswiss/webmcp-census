    "ora": "node src/fetch-ora.mjs",
    "aggregate": "node src/aggregate.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64",
    "@swissspidy/playwright-webmcp": "^0.3.0",
    "@swissspidy/webmcp-audit": "^0.3.0",
    "@swissspidy/webmcp-lint": "^0.3.0"
  }
}
